# Copy to `.env` and fill in from https://dashboard.emailjs.com
# The public key is safe to ship in the bundle; that is how EmailJS browser SDK works.
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=

# Supabase (Project Settings > API). Both values are public by design.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# This file is for the website only: every VITE_ value ends up in the browser, and
# these are exactly the variables Vercel needs. Secrets for the booking functions
# go in supabase/.env instead (see docs/reservations.md), never here.